# 本机状态 / 密钥 —— 绝不能进仓库
.env
*.env
progress.json

# 构建产物（build_offline.py / build_apk.py 生成，随时能重建）
认知训练-离线版.html
认知训练-离线版.src.txt
__pycache__/
*.pyc
server.log

# 截图（tools/shot_*.js 的产物，一张一两兆）
output/

# 手搓 Android 构建的中间目录（build_apk.py 自己会重建）
android/build/

# 环境目录
.venv/
.playwright-cli/

# 签名后的 idsig（每次构建都变）
*.idsig

# 注：android/认知训练.apk 是**有意**留在仓库里的交付物（deliver.py 会同步它，
# README 也把它当作"装到手机上就独立运行"的那一份），所以不忽略。

# 量尺用的对照页面（由 diag_step1_layout.js 的说明生成，不入库）
.tmpcmp/

# tools/ 下划线开头的 png 是各 check 脚本跑完留下的截图（只写不读）。
# 跟踪它们的话，每跑一次回归仓库就变"脏"，diff 里全是二进制噪声，
# 于是真正的改动被淹掉。文件本身留在磁盘上，只是不入库。
tools/_*.png
# Gradle 本机缓存与环境路径
android/.gradle/
android/app/build/
android/local.properties
android/gradle-*-bin.zip
android/gradle-[0-9]*/
\n
